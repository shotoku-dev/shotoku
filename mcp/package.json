{
  "name": "shotoku-mcp",
  "version": "0.1.1",
  "type": "module",
  "description": "Shotoku MCP server - gate any MCP tool call against a local spend and action policy.",
  "license": "MIT",
  "homepage": "https://github.com/shotoku-dev/shotoku#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shotoku-dev/shotoku.git",
    "directory": "mcp"
  },
  "bugs": "https://github.com/shotoku-dev/shotoku/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "authorization",
    "spend-controls",
    "approvals",
    "policy",
    "audit"
  ],
  "bin": {
    "shotoku-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @shotoku/core build",
    "test": "vitest run src --passWithNoTests",
    "prepack": "tsc -b"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@shotoku/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
